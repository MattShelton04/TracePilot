{
  "name": "@tracepilot/cli",
  "version": "0.8.2",
  "private": true,
  "description": "TracePilot CLI - inspect Copilot sessions from your terminal",
  "author": "Matt Shelton (@MattShelton04)",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/MattShelton04/TracePilot",
  "type": "module",
  "bin": {
    "tracepilot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --external:chalk --external:commander --external:yaml --outfile=dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@tracepilot/types": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "vitest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
